---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Case Studies | The Automation Specialist">
    <Nav />
    <main class="pt-40 pb-24 px-6 bg-white">
        <div class="max-w-7xl mx-auto">
            <h1 class="text-5xl font-bold mb-16">Revenue Architecture in Action</h1>
            
            <div class="grid lg:grid-cols-2 gap-12">
                <!-- Case Study Card -->
                <div class="border-2 border-gray-100 hover:border-specialist-red transition-all flex flex-col">
                    <div class="h-64 bg-architect-charcoal flex items-center justify-center text-white overflow-hidden p-12">
                        <h2 class="text-3xl font-bold italic text-center leading-tight">Project Spark: Global Transformation</h2>
                    </div>
                    <div class="p-10 flex-1 flex flex-col">
                        <span class="text-xs font-bold uppercase tracking-widest specialist-red mb-4">Tier-1 Telecommunications</span>
                        <h3 class="text-2xl font-bold mb-4 leading-tight">Multi-Market Marketing Automation Overhaul</h3>
                        <p class="text-gray-600 mb-8 flex-1">Transitioning a legacy monolithic Eloqua environment into a high-velocity Multi-Org architecture to support a 9% growth target.</p>
                        <a href="/case-studies/spark-transformation" class="governance-green font-bold flex items-center gap-2 group">
                            Read Full Transformation Blueprint
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-2 transition-transform"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
                        </a>
                    </div>
                </div>
                
                <div class="bg-[#F4F7F6] p-12 flex flex-col justify-center items-center text-center border border-dashed border-gray-300">
                    <p class="text-gray-400 font-bold uppercase tracking-widest mb-4">More Blueprints Coming Soon</p>
                    <p class="text-gray-500 max-w-xs italic">Architecting solutions for Ricoh, HSBC, and Air Products. Case studies undergoing clearance.</p>
                </div>
            </div>
        </div>
    </main>
    <Footer />
</BaseLayout>