---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ClientLogos from '../components/ClientLogos.astro';

const metadata = {
  title: "Architectural Case Studies | The Automation Specialist",
  description: "Enterprise strategic blueprints and integration governance case studies. Proof of architectural excellence from Lee Gorse.",
  keywords: "ABM Architecture, Marketing Technology Blueprints, Eloqua Consultant Case Study, Martech Governance"
};
---

<BaseLayout title={metadata.title} description={metadata.description} keywords={metadata.keywords}>
  <Nav />

  <main class="bg-white text-[#1A1A1B] min-h-screen pt-20">
    <!-- Header Section (Blueprint Grid Background) -->
    <section class="blueprint-grid py-20 border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-6">
        <span class="text-xs font-bold uppercase tracking-[0.3em] text-[#E31B23] block mb-3 font-mono">[ ARCHITECTURAL PROOF ]</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#1A1A1B] mb-6 leading-tight">
          System-Level <span class="italic text-[#004D40]">Case Studies</span>
        </h1>
        <p class="text-lg sm:text-xl text-gray-600 max-w-3xl leading-[1.6] font-light">
          Concrete evidence of high-touch technology governance, strategic design blueprints, and clean integration loops designed for complex enterprise marketing environments. I do not configure platforms; I design the ecosystems that accelerate pipeline.
        </p>
      </div>
    </section>

    <!-- Case Studies Grid -->
    <section class="max-w-7xl mx-auto px-6 py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

        <!-- Case Study 1: VMO2 -->
        <article class="bg-[#F4F7F6] border-2 border-gray-200/60 rounded-[4px] p-8 flex flex-col justify-between hover:border-[#E31B23] transition-all duration-300 shadow-sm relative group">
          <div>
            <div class="flex items-center justify-between gap-4 mb-6">
              <span class="px-3 py-1 bg-[#004D40]/5 text-[#004D40] text-xs font-bold uppercase tracking-wider rounded-[4px] border border-[#004D40]/10">
                Enterprise ABM Integration
              </span>
              <span class="text-xs font-mono text-gray-400">June 2026</span>
            </div>
            
            <h2 class="text-2xl lg:text-3xl font-bold text-[#1A1A1B] group-hover:text-[#E31B23] transition-colors duration-300 mb-4 leading-tight">
              VMO2: Architecting the Enterprise Revenue Engine
            </h2>
            
            <p class="text-gray-600 text-sm leading-[1.6] font-light mb-8">
              How I unified Oracle Eloqua, D&B RevUp, and Salesforce CRM to deliver real-time Account-Level Recommendation alerts directly to enterprise sales dashboards, dropping latency from 7 days to under 15 minutes.
            </p>

            <div class="grid grid-cols-2 gap-4 border-t border-gray-200/80 pt-6 mb-8">
              <div>
                <span class="block text-gray-400 text-[10px] uppercase tracking-wider mb-1 font-mono">Integrations</span>
                <span class="text-[#1A1A1B] text-sm font-bold">Eloqua + RevUp + Salesforce</span>
              </div>
              <div>
                <span class="block text-gray-400 text-[10px] uppercase tracking-wider mb-1 font-mono">Primary Focus</span>
                <span class="text-[#1A1A1B] text-sm font-bold">Zero-Latency Intent Loop</span>
              </div>
            </div>
          </div>
          
          <div>
            <a href="/case-studies/vmo2-revenue-engine" class="btn-red text-center text-white px-6 py-3 rounded-[4px] font-bold text-sm tracking-wider uppercase inline-block w-full sm:w-auto hover:opacity-90 transition-opacity">
              Read Blueprint
            </a>
          </div>
        </article>

        <!-- Case Study 2: Spark Transformation -->
        <article class="bg-[#F4F7F6] border-2 border-gray-200/60 rounded-[4px] p-8 flex flex-col justify-between hover:border-[#E31B23] transition-all duration-300 shadow-sm relative group">
          <div>
            <div class="flex items-center justify-between gap-4 mb-6">
              <span class="px-3 py-1 bg-[#004D40]/5 text-[#004D40] text-xs font-bold uppercase tracking-wider rounded-[4px] border border-[#004D40]/10">
                System Migration &amp; SLA Alignment
              </span>
              <span class="text-xs font-mono text-gray-400">Historical</span>
            </div>
            
            <h2 class="text-2xl lg:text-3xl font-bold text-[#1A1A1B] group-hover:text-[#E31B23] transition-colors duration-300 mb-4 leading-tight">
              Spark Transformation: Legacy to Cloud Orchestration
            </h2>
            
            <p class="text-gray-600 text-sm leading-[1.6] font-light mb-8">
              A comprehensive blueprint mapping legacy database pipelines into a streamlined Marketo/Adobe Cloud deployment. Standardized global lead hand-off rules and established operational SLAs for cross-border markets.
            </p>

            <div class="grid grid-cols-2 gap-4 border-t border-gray-200/80 pt-6 mb-8">
              <div>
                <span class="block text-gray-400 text-[10px] uppercase tracking-wider mb-1 font-mono">Integrations</span>
                <span class="text-[#1A1A1B] text-sm font-bold">Adobe Cloud Migration</span>
              </div>
              <div>
                <span class="block text-gray-400 text-[10px] uppercase tracking-wider mb-1 font-mono">Primary Focus</span>
                <span class="text-[#1A1A1B] text-sm font-bold">SLA Governance Blueprints</span>
              </div>
            </div>
          </div>
          
          <div>
            <a href="/case-studies/spark-transformation" class="btn-red text-center text-white px-6 py-3 rounded-[4px] font-bold text-sm tracking-wider uppercase inline-block w-full sm:w-auto hover:opacity-90 transition-opacity">
              Read Blueprint
            </a>
          </div>
        </article>

      </div>
    </section>

    <!-- Social Proof Client Logo Bar Component -->
    <section class="max-w-7xl mx-auto px-6 pb-12">
      <ClientLogos />
    </section>
  </main>

  <Footer />
</BaseLayout>