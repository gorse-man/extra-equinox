---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ClientLogos from '../../components/ClientLogos.astro';

// Structured Metadata targeting high-value Enterprise consulting queries
const metadata = {
  title: "Project Spark: Global Marketing Automation Transformation | TAMS",
  description: "How Lee Gorse (The Automation Specialist) architected a global CoE operating model and multi-org Eloqua/Salesforce infrastructure for a Tier-1 Telco.",
  keywords: "Martech Centre of Excellence, Eloqua Solution Architect, Marketing Automation Operating Model, Salesforce Integration App, Telco B2B GTM Strategy"
};
---

<BaseLayout title={metadata.title} description={metadata.description} keywords={metadata.keywords}>
  <Nav />

  <main class="bg-white text-[#1A1A1B] min-h-screen pt-20 overflow-x-hidden">
    <!-- Hero / Header Section (Blueprint Grid Background) -->
    <section class="blueprint-grid py-20 border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <span class="inline-flex items-center px-3.5 py-1 rounded-[4px] text-xs font-bold uppercase tracking-wider bg-[#004D40]/5 text-[#004D40] border border-[#004D40]/15">
            Operating Model &amp; Technical Architecture
          </span>
          <div class="text-xs text-gray-500 font-mono">
            Sector: <span class="text-[#1A1A1B] font-bold">Tier-1 Global Telecommunications</span> &nbsp;|&nbsp; Timeline: <span class="text-[#1A1A1B] font-bold">FY25 – FY26</span>
          </div>
        </div>
        
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#1A1A1B] mb-6 leading-tight">
          Global Marketing Automation <br />
          Transformation: <span class="text-[#004D40] italic font-serif">Project Spark</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-gray-600 max-w-4xl leading-[1.6] font-light">
          How I designed the global CoE framework and multi-tenant marketing architecture to standardise campaigns across 10 operating companies, reducing speed-to-lead latency from hours to minutes.
        </p>

        <!-- Key Impact Metrics Bar -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
          <div class="bg-white p-6 rounded-[4px] border border-gray-200 shadow-sm hover:border-[#E31B23]/30 transition-all duration-300">
            <div class="text-xs font-bold text-[#E31B23] uppercase tracking-wider mb-1 font-mono">Speed-to-Lead</div>
            <div class="text-2xl font-bold text-[#1A1A1B] mb-1">Hours &rarr; Minutes</div>
            <p class="text-xs text-gray-500 font-light leading-[1.6]">Immediate follow-up secured for high-intent B2B hand-raisers.</p>
          </div>
          <div class="bg-white p-6 rounded-[4px] border border-gray-200 shadow-sm hover:border-[#E31B23]/30 transition-all duration-300">
            <div class="text-xs font-bold text-[#004D40] uppercase tracking-wider mb-1 font-mono">Target Growth</div>
            <div class="text-2xl font-bold text-[#1A1A1B] mb-1">+9% B2B Revenue</div>
            <p class="text-xs text-gray-500 font-light leading-[1.6]">Framework structured specifically to scale SME &amp; MNC pipeline.</p>
          </div>
          <div class="bg-white p-6 rounded-[4px] border border-gray-200 shadow-sm hover:border-[#E31B23]/30 transition-all duration-300">
            <div class="text-xs font-bold text-[#004D40] uppercase tracking-wider mb-1 font-mono">Unified estate</div>
            <div class="text-2xl font-bold text-[#1A1A1B] mb-1">10 Markets</div>
            <p class="text-xs text-gray-500 font-light leading-[1.6]">Audited and aligned under a cohesive CoE governance system.</p>
          </div>
          <div class="bg-white p-6 rounded-[4px] border border-gray-200 shadow-sm hover:border-[#E31B23]/30 transition-all duration-300">
            <div class="text-xs font-bold text-[#E31B23] uppercase tracking-wider mb-1 font-mono">My Strategic Role</div>
            <div class="text-2xl font-bold text-[#1A1A1B] mb-1">Lead Advisor</div>
            <p class="text-xs text-gray-500 font-light leading-[1.6]">CoE Design Lead managing global stake-holding groups.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Executive Summary Section -->
    <section class="max-w-7xl mx-auto px-6 py-16">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 space-y-8">
          <div>
            <h2 class="text-2xl font-bold text-[#1A1A1B] mb-4 flex items-center gap-2">
              <span class="w-2.5 h-2.5 bg-[#E31B23] rounded-none"></span> 1. Executive Summary
            </h2>
            <div class="text-gray-700 space-y-4 leading-[1.6] font-light">
              <p>
                Project Spark represented the strategic overhaul of the global B2B Marketing Automation Platform (MAP) environment to unlock high-velocity growth across ten key operating companies (OpCos).
              </p>
              <p>
                The initiative delivered on a dual corporate mandate:
              </p>
              <ul class="space-y-3 list-none pl-0 mt-4 text-gray-700">
                <li class="flex items-start gap-3">
                  <span class="text-[#E31B23] font-bold font-mono">[✓]</span>
                  <span><strong>Technical Modernisation:</strong> I governed the migration of the primary B2B marketing engine from legacy, high-maintenance Program Builder logic and the outdated Eloqua 9 integration engine to the modern <strong>Program Canvas</strong> and the cloud-native <strong>Salesforce Integration App</strong>. This technical leap compressed B2B speed-to-lead times from hours to near real-time.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-[#E31B23] font-bold font-mono">[✓]</span>
                  <span><strong>Operating Model Optimisation:</strong> I audited marketing use cases, integration standards, and technologies across global OpCos to establish a standardised, centre-led operating model. This framework directly supported the organisation's 9% annual growth target in the high-value Small to Medium Enterprise (SME) and Multi-National Corporation (MNC) segments.</span>
                </li>
              </ul>
              <p class="pt-2">
                By standardising technical frameworks while preserving local market autonomy, this transformation built a repeatable, "cookie-cutter" operational template designed to scale Beyond Connectivity (BNC) product penetration across the global footprint.
              </p>
            </div>
          </div>

          <div>
            <h2 class="text-2xl font-bold text-[#1A1A1B] mb-4 flex items-center gap-2">
              <span class="w-2.5 h-2.5 bg-[#E31B23] rounded-none"></span> 2. Business Problem Statement
            </h2>
            <div class="text-gray-700 space-y-4 leading-[1.6] font-light">
              <p>
                Prior to Project Spark, the B2B marketing and sales engine faced deep structural constraints that caused extreme latency, high overheads, and inconsistent customer journeys:
              </p>
              
              <div class="bg-[#F4F7F6] p-6 rounded-[4px] border border-gray-200 space-y-4 my-6">
                <div>
                  <h4 class="text-sm font-bold text-[#1A1A1B] uppercase tracking-wider font-mono mb-1">Fragmented Tech Disparities</h4>
                  <p class="text-xs text-gray-600 font-light leading-[1.6]">
                    Our global Audit revealed that local CRMs were split between modern Sales Cloud (Salesforce in the UK, Ireland, and MNC), Siebel (Albania, Greece, and the Czech Republic), and Amdocs (Romania). Correspondingly, local B2B marketing platforms ranged from Eloqua and Salesforce Marketing Cloud down to local instances of Zoho and legacy IBM Unica.
                  </p>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-[#1A1A1B] uppercase tracking-wider mb-1 font-mono">Pega vs. Eloqua Strategic Divergence</h4>
                  <p class="text-xs text-gray-500 font-light leading-[1.6]">
                    While large enterprise accounts required complex, multi-touch nurturing via Oracle Eloqua or SFMC, consumer and micro-segments (SoHo) were best served by high-volume decisioning engines (Pega). The boundaries between these platforms were blurred, creating disconnected customer experiences and misaligned budgets.
                  </p>
                </div>
                <div>
                  <h4 class="text-xs font-bold text-[#E31B23] uppercase tracking-wider mb-1 font-mono">Processing Latency &amp; Skill Gaps</h4>
                  <p class="text-xs text-gray-500 font-light leading-[1.6]">
                    Legacy point-to-point batch data flows delayed lead distribution to business development representatives (BDRs) and sales teams by over an hour, causing high-value inbound demand to go cold. Additionally, smaller OpCos lacked specialized resources, forcing them to treat marketing systems as mere batch email tools.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar Details -->
        <div class="space-y-6">
          <div class="bg-[#F4F7F6] border border-gray-200 p-6 rounded-[4px] shadow-sm">
            <h3 class="text-md font-bold uppercase tracking-wider text-[#1A1A1B] mb-4 border-b border-gray-200 pb-2 font-mono">Engagement Parameters</h3>
            <div class="space-y-4 text-xs">
              <div>
                <span class="block text-gray-400 uppercase tracking-wider mb-1 font-mono">Client Type</span>
                <span class="text-[#1A1A1B] font-bold">Tier 1 Global Telecommunications</span>
              </div>
              <div>
                <span class="block text-gray-400 uppercase tracking-wider mb-1 font-mono">Role Profile</span>
                <span class="text-[#E31B23] font-bold font-mono">Lead Solution Architect</span>
              </div>
              <div>
                <span class="block text-gray-400 uppercase tracking-wider mb-1 font-mono">Migration Scope</span>
                <span class="text-[#1A1A1B] font-bold">Eloqua, Marketo, Salesforce, Pega, Siebel DXL</span>
              </div>
              <div>
                <span class="block text-gray-400 uppercase tracking-wider mb-1 font-mono">Governance Scope</span>
                <span class="text-[#1A1A1B] font-bold">10 Local Operating Companies (OpCos)</span>
              </div>
            </div>
          </div>

          <div class="bg-[#004D40] text-white p-6 rounded-[4px]">
            <h4 class="text-[#A7FFEB] font-bold uppercase tracking-wider text-xs mb-2 font-mono">The Operating Creed</h4>
            <p class="text-sm leading-[1.6] font-light">
              "When standardising global Martech, the goal is never to build a single giant monolith. It is about defining clear SLAs, establishing rigid integration boundaries, and giving regional teams local operational autonomy within a standardized blueprint."
            </p>
            <span class="block mt-4 text-[10px] uppercase tracking-wider font-mono text-white/50">— Lee Gorse</span>
          </div>
        </div>
      </div>
    </section>

    <!-- The 4-Layer Solution Topology Grid -->
    <section class="bg-[#F4F7F6] py-16 border-y border-gray-200">
      <div class="max-w-7xl mx-auto px-6">
        <div class="max-w-3xl mb-12">
          <span class="text-xs font-bold uppercase tracking-widest text-[#E31B23] block mb-2 font-mono">[ SOLUTION MODEL ]</span>
          <h2 class="text-3xl font-bold text-[#1A1A1B] mb-4">
            The Centre of Excellence (CoE) GTM Framework
          </h2>
          <p class="text-gray-600 leading-[1.6] font-light">
            I aligned the transformation around my proprietary <strong>Four-Layer Framework</strong> to systematically replace point-to-point technical debt with institutional governance.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Process -->
          <div class="bg-white p-6 rounded-[4px] border border-gray-200 relative overflow-hidden group hover:border-[#E31B23] transition-all duration-300 shadow-sm">
            <div class="absolute top-0 left-0 w-1 h-full bg-[#004D40]"></div>
            <div class="text-[#004D40] font-mono text-xs mb-3 font-bold">A. PROCESS LAYER</div>
            <h3 class="text-lg font-bold text-[#1A1A1B] mb-2 leading-tight">Standardised Funnels</h3>
            <p class="text-gray-600 text-xs leading-[1.6] font-light">
              Implemented a unified lead blueprint across the audited estate: Prospect &gt; Inquiry &gt; Automated Qualified Lead (AQL) &gt; Marketing Qualified Lead (MQL) &gt; Opportunity, governed by strict 1-hour follow-up SLAs on hand-raisers.
            </p>
          </div>

          <!-- Application -->
          <div class="bg-white p-6 rounded-[4px] border border-gray-200 relative overflow-hidden group hover:border-[#E31B23] transition-all duration-300 shadow-sm">
            <div class="absolute top-0 left-0 w-1 h-full bg-[#E31B23]"></div>
            <div class="text-[#E31B23] font-mono text-xs mb-3 font-bold">B. APPLICATION LAYER</div>
            <h3 class="text-lg font-bold text-[#1A1A1B] mb-2 leading-tight">Federated Autonomy</h3>
            <p class="text-gray-600 text-xs leading-[1.6] font-light">
              Decommissioned the monolithic group system. Turkish, MNC, UK, and Irish business units were separated into local dedicated production tenants to execute high-velocity campaigns, while Germany was aligned to SFMC.
            </p>
          </div>

          <!-- Data -->
          <div class="bg-white p-6 rounded-[4px] border border-gray-200 relative overflow-hidden group hover:border-[#E31B23] transition-all duration-300 shadow-sm">
            <div class="absolute top-0 left-0 w-1 h-full bg-[#1A1A1B]"></div>
            <div class="text-[#1A1A1B] font-mono text-xs mb-3 font-bold">C. DATA LAYER</div>
            <h3 class="text-lg font-bold text-[#1A1A1B] mb-2 leading-tight">Unified Analytics &amp; GDPR</h3>
            <p class="text-gray-600 text-xs leading-[1.6] font-light">
              Standardised the schema to calculate Marketing Influenced (MIO) and Generated (MGO) Opportunities, mapped directly into Tableau. Localised preference centres to ensure strict compliance (GDPR/KVKK).
            </p>
          </div>

          <!-- People -->
          <div class="bg-white p-6 rounded-[4px] border border-gray-200 relative overflow-hidden group hover:border-[#E31B23] transition-all duration-300 shadow-sm">
            <div class="absolute top-0 left-0 w-1 h-full bg-[#004D40]"></div>
            <div class="text-[#004D40] font-mono text-xs mb-3 font-bold">D. PEOPLE LAYER</div>
            <h3 class="text-lg font-bold text-[#1A1A1B] mb-2 leading-tight">Centre-Led MOPS</h3>
            <p class="text-gray-600 text-xs leading-[1.6] font-light">
              Created a conversion training program to transition consumer marketers into B2B specialists. Embedded a lead strategist role at group-level to evaluate tech, while Shared Services executed campaigns.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Visual Architecture Section -->
    <section class="max-w-7xl mx-auto px-6 py-16">
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#E31B23] block mb-2 font-mono">FEDERATED BLUEPRINT</span>
        <h2 class="text-3xl font-bold text-[#1A1A1B]">
          Federated Operating Model Schematic
        </h2>
        <p class="text-gray-600 leading-[1.6] font-light mt-4">
          Visualizing the transition from disjointed regional databases to a unified central B2B Centre of Excellence (CoE) controlling technical standards.
        </p>
      </div>

      <div class="bg-[#1A1A1B] text-white rounded-[4px] p-6 sm:p-10 shadow-xl relative">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-stretch">
          
          <!-- Central CoE Block -->
          <div class="bg-white/5 border border-white/10 p-6 rounded-[4px] flex flex-col justify-between lg:col-span-1">
            <div>
              <span class="text-[10px] font-mono text-[#A7FFEB] bg-[#A7FFEB]/10 px-2 py-0.5 rounded-[4px] block w-fit mb-4">CENTRE-LED GOVERNANCE</span>
              <h3 class="text-lg font-bold text-white mb-2 font-mono">B2B CoE Core</h3>
              <p class="text-xs text-gray-400 font-light leading-[1.6] mb-6">
                Standardizes schemas, owns the Tableau reporting models, builds turnkey campaign nurtures, and runs compliance reviews.
              </p>
            </div>
            <div class="text-[#A7FFEB] font-mono text-xs">
              &rarr; Structural Control
            </div>
          </div>

          <!-- Path Arrows -->
          <div class="flex flex-col items-center justify-center text-center lg:col-span-3 lg:grid lg:grid-cols-3 gap-6">
            
            <!-- OpCo 1 -->
            <div class="bg-white/5 border border-white/10 p-5 rounded-[4px] w-full relative">
              <span class="absolute top-2 right-2 text-[9px] font-mono text-gray-400">UK / IE</span>
              <h4 class="text-sm font-bold text-white mb-1 font-mono">Isolated Eloqua Tenant</h4>
              <p class="text-[11px] text-gray-400 font-light leading-relaxed mb-3">Standalone Salesforce Integration App routing directly to local Salesforce Sales Cloud.</p>
              <div class="text-xs font-mono text-[#E31B23]">&lt;15 Mins Lead Time</div>
            </div>

            <!-- OpCo 2 -->
            <div class="bg-white/5 border border-white/10 p-5 rounded-[4px] w-full relative">
              <span class="absolute top-2 right-2 text-[9px] font-mono text-gray-400">TR / CZ</span>
              <h4 class="text-sm font-bold text-white mb-1 font-mono">Autonomy Tenant</h4>
              <p class="text-[11px] text-gray-400 font-light leading-relaxed mb-3">Custom REST post-routings configured directly to localized Siebel CRM instances.</p>
              <div class="text-xs font-mono text-[#A7FFEB]">KVKK / Privacy Aligned</div>
            </div>

            <!-- OpCo 3 -->
            <div class="bg-white/5 border border-white/10 p-5 rounded-[4px] w-full relative">
              <span class="absolute top-2 right-2 text-[9px] font-mono text-gray-400">DE / RO</span>
              <h4 class="text-sm font-bold text-white mb-1 font-mono">SFMC &amp; Amdocs</h4>
              <p class="text-[11px] text-gray-400 font-light leading-relaxed mb-3">Standardized B2B funnels and campaign frameworks localized on Pega and SFMC structures.</p>
              <div class="text-xs font-mono text-[#A7FFEB]">SLA Blueprints Met</div>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- Results & Business Impact -->
    <section class="max-w-7xl mx-auto px-6 py-16">
      <div class="bg-[#1A1A1B] text-white p-8 sm:p-12 rounded-[4px] relative">
        <span class="text-xs font-bold uppercase tracking-widest text-[#E31B23] block mb-2 font-mono">[ REALIZED RESULTS ]</span>
        <h2 class="text-3xl font-bold mb-8 italic">4. Business Impact &amp; Results</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-6">
            <div>
              <h4 class="text-lg font-bold text-[#A7FFEB] mb-2 flex items-center gap-2">
                <span class="text-[#E31B23] font-mono font-bold">[✓]</span> Immediate Speed-to-Lead Gains
              </h4>
              <p class="text-gray-400 text-xs leading-[1.6] font-light">
                By abandoning Program Builder and integrating Eloqua's modern Salesforce Integration App, processing latency was smashed. High-intent, hand-raising inbound leads now reach regional sales representatives in minutes instead of hours.
              </p>
            </div>

            <div>
              <h4 class="text-lg font-bold text-[#A7FFEB] mb-2 flex items-center gap-2">
                <span class="text-[#E31B23] font-mono font-bold">[✓]</span> Operating Model Efficiencies
              </h4>
              <p class="text-gray-400 text-xs leading-[1.6] font-light">
                Establishing the CoE allowed local operating companies to share standardized campaign best practices and pre-built assets, cutting campaign configuration times, eliminating external agency costs, and mitigating data entry error.
              </p>
            </div>
          </div>

          <div class="space-y-6">
            <div>
              <h4 class="text-lg font-bold text-[#A7FFEB] mb-2 flex items-center gap-2">
                <span class="text-[#E31B23] font-mono font-bold">[✓]</span> MNC Account Visibility
              </h4>
              <p class="text-gray-400 text-xs leading-[1.6] font-light">
                Shifting global analytics to a product-interest model allowed international account managers to map entire buyer groups across complex multinational corporations (MNCs), vastly improving cross-sell and upsell precision.
              </p>
            </div>

            <div>
              <h4 class="text-lg font-bold text-[#A7FFEB] mb-2 flex items-center gap-2">
                <span class="text-[#E31B23] font-mono font-bold">[✓]</span> Revenue Readiness
              </h4>
              <p class="text-gray-400 text-xs leading-[1.6] font-light">
                Establishing consistent MOPS expertise and modern data schemas built the necessary foundations to scale "Beyond Connectivity" (BNC) cloud products, directly enabling Vodafone's incremental revenue ambitions.
              </p>
            </div>
          </div>
        </div>

        <!-- Call to Action Footer -->
        <div class="border-t border-white/10 mt-12 pt-8 flex flex-col sm:flex-row items-center justify-between gap-6">
          <div>
            <p class="text-white font-bold text-lg mb-1">Looking to implement technical governance across global operating teams?</p>
            <p class="text-gray-400 text-sm font-light">Stop managing silos. Structure a high-velocity center of excellence.</p>
          </div>
          <a href="/contact" class="btn-red px-6 py-3 text-white font-bold rounded-[4px] tracking-wider uppercase inline-block hover:opacity-90 transition-opacity text-center w-full sm:w-auto">
            Arrange System Audit
          </a>
        </div>
      </div>
    </section>

    <!-- Social Proof Client Logo Bar Component -->
    <section class="max-w-7xl mx-auto px-6 pt-8 pb-12">
      <ClientLogos />
    </section>
  </main>

  <Footer />
</BaseLayout>