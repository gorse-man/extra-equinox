<section class="blueprint-grid pt-40 pb-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-12 items-center">
        <div>
            <h1 class="text-5xl lg:text-7xl font-bold leading-[1.1] mb-6 tracking-tight">
                Blueprints for the <br />
                <span class="specialist-red font-italic">Modern Revenue</span> Engine.
            </h1>
            <p class="text-xl lg:text-2xl font-semibold mb-8 max-w-xl governance-green">
                I work with your IT, Sales and Marketing Teams to optimise your Processes, Application Know-How, and Data Quality to close the loop on marketing attribution and sales velocity.
            </p>
            <a href="/contact" class="btn-red px-8 py-4 text-white font-bold text-lg rounded-sm inline-flex items-center gap-3 shadow-xl shadow-red-500/10 hover:-translate-y-0.5 transition-transform">
    Contact Me
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
</a>
        </div>
        <div class="relative flex items-center justify-center py-10">
            <svg viewBox="0 0 400 450" class="w-full max-w-[500px] drop-shadow-2xl">
                <g transform="translate(50, 50)">
                    <path d="M150 0 L300 75 L150 150 L0 75 Z" fill="rgba(255,255,255,0.9)" stroke="#004D40" stroke-width="1.5" />
                    <text x="100" y="85" font-size="10" font-weight="bold" class="uppercase fill-[#004D40]">Process Layer</text>
                </g>
                <g transform="translate(50, 130)">
                    <path d="M150 0 L300 75 L150 150 L0 75 Z" fill="rgba(255,255,255,0.7)" stroke="#E31B23" stroke-width="1.5" />
