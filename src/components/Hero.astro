                </g>
                <g transform="translate(50, 210)">
                    <path d="M150 0 L300 75 L150 150 L0 75 Z" fill="rgba(255,255,255,0.5)" stroke="#1A1A1B" stroke-width="1.5" />
                    <text x="110" y="85" font-size="10" font-weight="bold" class="uppercase fill-[#1A1A1B]">Data Layer</text>
                </g>
                <g transform="translate(50, 290)">
                    <path d="M150 0 L300 75 L150 150 L0 75 Z" fill="rgba(26,26,27,0.1)" stroke="#1A1A1B" stroke-width="2" />
                    <text x="100" y="85" font-size="10" font-weight="bold" class="uppercase fill-black">Integration Layer</text>
