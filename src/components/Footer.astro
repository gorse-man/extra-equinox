---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#004D40] text-[#F4F7F6] py-12 border-t border-[#004D40]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      
      <!-- Brand & Architectural Statement -->
      <div class="text-center md:text-left">
        <p class="font-sans font-bold text-lg text-white tracking-wide">
          The Automation Specialist Ltd
        </p>
        <p class="font-mono text-xs text-[#A7FFEB] mt-1">
          High-Touch Martech Architecture & Strategic Governance
        </p>
      </div>

      <!-- Social, Professional & Direct Contact Channels -->
      <div class="flex items-center space-x-4 sm:space-x-5 flex-wrap justify-center">
        <!-- LinkedIn -->
        <a 
          href="https://www.linkedin.com/in/leegorse/" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="LinkedIn Profile"
          class="text-[#F4F7F6] hover:text-[#E31B23] transition-colors duration-200"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
          </svg>
        </a>

        <!-- Salesforce Trailblazer -->
        <a 
          href="https://www.salesforce.com/trailblazer/leegorse" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Salesforce Trailblazer Profile"
          class="text-[#F4F7F6] hover:text-[#E31B23] transition-colors duration-200"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M16.11 4.5a5.53 5.53 0 0 0-4.75 2.68 4.26 4.26 0 0 0-3.86.38 4.23 4.23 0 0 0-2 3.32 4.67 4.67 0 0 0-3.5 4.52C2 18 4 19.5 6.5 19.5h11c2.48 0 4.5-2.02 4.5-4.5 0-2.12-1.47-3.89-3.46-4.35A5.51 5.51 0 0 0 16.11 4.5z"/>
          </svg>
        </a>

        <!-- X (formerly Twitter) -->
        <a 
          href="https://x.com/leegorse" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="X Profile"
          class="text-[#F4F7F6] hover:text-[#E31B23] transition-colors duration-200"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>

        <!-- Facebook -->
        <a 
          href="https://facebook.com/lee.gorse" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Facebook Profile"
          class="text-[#F4F7F6] hover:text-[#E31B23] transition-colors duration-200"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H7.5v-3H10V9.5C10 7.01 11.49 5.65 13.75 5.65c1.08 0 2.21.19 2.21.19v2.43h-1.25c-1.23 0-1.62.77-1.62 1.56V12h2.73l-.44 3h-2.29v6.8c4.56-.93 8-4.96 8-9.8z"/>
          </svg>
        </a>

        <!-- WhatsApp -->
        <a 
          href="https://wa.me/447378732412" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="WhatsApp Direct Line"
          class="text-[#F4F7F6] hover:text-[#E31B23] transition-colors duration-200"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 16.5c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.32a8.188 8.188 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.183 8.183 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.22 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.8-.23-.09-.39-.12-.56.12-.17.25-.66.8-.81.97-.15.17-.3.19-.55.07-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.16-.25.24-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.84-.86 2.05 0 1.21.88 2.38 1.01 2.55.12.17 1.74 2.65 4.21 3.72.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.48-.3z"/>
          </svg>
        </a>

        <!-- Instagram -->
        <a 
          href="https://instagram.com/lee.gorse" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Instagram Profile"
          class="text-[#F4F7F6] hover:text-[#E31B23] transition-colors duration-200"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <!-- Linktree -->
        <a 
          href="https://linktr.ee/lee.gorse" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Linktree Hub"
          class="text-[#F4F7F6] hover:text-[#E31B23] transition-colors duration-200"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M13.736 5.853l4.005-4.017 2.225 2.225-3.993 3.993h5.281v3.146h-7.518l4.017 4.005-2.225 2.225-4.005-4.017v6.842h-3.146v-6.842l-4.005 4.017-2.225-2.225 4.017-4.005H0V8.054h5.281L1.288 4.061l2.225-2.225 4.005 4.017V0h3.146v5.853zM10.428 17.653h3.146V24h-3.146v-6.347z"/>
          </svg>
        </a>
      </div>

      <!-- Legal & Governance -->
      <div class="text-center md:text-right text-xs text-[#F4F7F6]/80 font-sans">
        <p>&copy; {currentYear} The Automation Specialist Ltd. All rights reserved.</p>
        <p class="mt-1">
          <a href="/privacy" class="hover:text-[#A7FFEB] underline transition-colors">Privacy Policy</a>
        </p>
      </div>

    </div>
  </div>
</footer>